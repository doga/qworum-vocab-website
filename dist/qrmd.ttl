BASE <https://vocab.qworum.net/qrmd.ttl>

PREFIX qrmd: <#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://vocab.qworum.net/qrmd.ttl>
  vann:preferredNamespacePrefix 'qrmd';
  vann:preferredNamespaceUri 'https://vocab.qworum.net/qrmd.ttl#'^^xsd:anyURI ;
  rdfs:label 'QRMD Ontology'@en;
  rdfs:comment '''
    Defines datatypes.
  '''@en.

qrmd:anyIRI a rdfs:Datatype ;
  rdfs:label 'IRI'@en;
  rdfs:comment '''
    A literal that is an IRI. When an IRI does not lead to the definition of an RDF resource, then the IRI should be contained in an RDF literal.
  '''@en;
  skos:exactMatch xsd:anyURI .

qrmd:json a rdfs:Datatype ;
  rdfs:label 'JSON'@en;
  rdfs:comment '''
    JSON (JavaScript Object Notation) content.
  '''@en;
  rdfs:range rdfs:Literal ;
  rdfs:seeAlso 'https://www.json.org/json-en.html'^^qrmd:anyIRI .

qrmd:markdown a rdfs:Datatype ;
  rdfs:label 'Markdown text'@en;
  rdfs:comment '''
    Text written in the Markdown format. Any justification to the right is not significant. This means that the same number of space characters are removed from the beginning of all lines until at least one line starts with a non-space character; only then is the Markdown text parsed.

    YAML frontmatter is allowed, and the optional `lang` attribute defines the content language. Example:

    ---
    lang: en
    ---
    # Title

    Content.
  '''@en;
  rdfs:range rdfs:Literal ;
  rdfs:seeAlso
    'https://en.wikipedia.org/wiki/Markdown'^^qrmd:anyIRI ,
    'https://daringfireball.net/projects/markdown/'^^qrmd:anyIRI .

qrmd:md skos:exactMatch qrmd:markdown .

qrmd:mermaid a rdfs:Datatype ;
  rdfs:label 'Mermaid diagram'@en;
  rdfs:comment '''
    A text format to create diagrams and visualizations.
  '''@en;
  rdfs:range rdfs:Literal ;
  rdfs:seeAlso 'https://mermaid.ai/open-source/intro/'^^qrmd:anyIRI .

qrmd:mmd skos:exactMatch qrmd:mermaid .
